<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!--
      Must stay true even though the app ships unpackaged (WindowsPackageType=None).
      The MSIX tooling carries the PRI/MRT resource pipeline: with it disabled the
      published app has no resources.pri entry for the compiled .xbf files, and
      MainWindow.InitializeComponent throws XamlParseException "Cannot locate
      resource from 'ms-appx:///MainWindow.xaml'" at startup.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <ProjectReference Include="../Atlas.AI/Atlas.AI.csproj" />
    <ProjectReference Include="../Atlas.Application/Atlas.Application.csproj" />
    <ProjectReference Include="../Atlas.Domain/Atlas.Domain.csproj" />
    <ProjectReference Include="../Atlas.Infrastructure/Atlas.Infrastructure.csproj" />
    <ProjectReference Include="../Atlas.Memory/Atlas.Memory.csproj" />
    <ProjectReference Include="../Atlas.WindowsBridge/Atlas.WindowsBridge.csproj" />
  </ItemGroup>
</Project>
