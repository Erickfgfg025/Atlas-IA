<UserControl
    x:Class="Atlas.Desktop.Controls.OrganicOrb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <Grid>
        <Ellipse Margin="8" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A8F28C28" Offset="0"/>
                    <GradientStop Color="#00F28C28" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" CenterX="87" CenterY="87" ScaleX="1.0" ScaleY="1.0"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Margin="28">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.32,0.28" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#FFF8DCC0" Offset="0"/>
                    <GradientStop Color="#FFF28C28" Offset="0.28"/>
                    <GradientStop Color="#FFB84B25" Offset="0.62"/>
                    <GradientStop Color="#FF28202A" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Shadow>
                <ThemeShadow/>
            </Ellipse.Shadow>
        </Ellipse>
        <Ellipse Width="54" Height="25" Margin="0,0,34,58"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#66FFFFFF" Opacity="0.42">
            <Ellipse.RenderTransform>
                <RotateTransform Angle="-28"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
