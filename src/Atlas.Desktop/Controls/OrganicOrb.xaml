<UserControl
    x:Class="Atlas.Desktop.Controls.OrganicOrb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Viewbox Stretch="Uniform">
        <Grid Width="800" Height="600" Background="Transparent">
            <Path x:Name="BackWave" StrokeThickness="18" Opacity="0.28"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 20,300 C 120,285 155,190 250,220 C 340,250 355,390 450,360 C 550,328 570,185 665,225 C 720,248 750,290 780,300">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#C96F1B" Offset="0.32"/>
                        <GradientStop Color="#F28C28" Offset="0.58"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <Path x:Name="MainWave" StrokeThickness="11" Opacity="0.95"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 15,310 C 110,305 165,235 250,260 C 335,285 360,355 445,340 C 535,325 570,235 650,260 C 710,278 750,305 785,310">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#F28C28" Offset="0.25"/>
                        <GradientStop Color="#FFD9A8" Offset="0.49"/>
                        <GradientStop Color="#C96F1B" Offset="0.72"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
            <Path x:Name="FrontWave" StrokeThickness="5" Opacity="0.72"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 25,330 C 135,325 180,280 260,290 C 350,302 370,335 455,325 C 550,315 585,275 670,290 C 720,300 755,320 775,325">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FFB35C" Offset="0.36"/>
                        <GradientStop Color="#FFF1E0" Offset="0.52"/>
                        <GradientStop Color="#FFB35C" Offset="0.7"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
