# Backend only. Never embed these values in the desktop client.
ATLAS_APP_NAME=ATLAS AI
ATLAS_ENVIRONMENT=development
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=8000
ATLAS_LOG_LEVEL=INFO

# local (default) stores memories on this computer; supabase enables cloud auth + storage.
ATLAS_MEMORY_BACKEND=local
# Optional. Leave empty to use the operating-system per-user data directory.
ATLAS_LOCAL_DB_PATH=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only needed when ATLAS_MEMORY_BACKEND=supabase.
SUPABASE_URL=
# Use the project's publishable/anon key here, never service_role or a secret key.
SUPABASE_KEY=

# Cloud voice credentials belong only in the backend environment.
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s1
ATLAS_MAX_AUDIO_UPLOAD_MB=20
